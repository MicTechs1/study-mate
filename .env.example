# Required only for hosted AI answers (chat + vision). Without it, StudyMate
# answers using on-device replies and anonymous people/object detection.
OPENAI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public site URL used by sitemap.ts and robots.ts (set in production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: change server log verbosity. One of debug|info|warn|error.
# LOG_LEVEL=info